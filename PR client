    /**
     * Add labels to a pull request.
     */
    public static function add_labels($user_id, $repo, $pr_number, array $labels) {
        try {
            GitHub_Agent_Permission_Manager::assert_can(
                $user_id,
                $repo,
                'create_pr'
            );
        } catch (Exception $e) {
            return new WP_Error('permission_denied', $e->getMessage(), array('status' => 403));
        }

        if (empty($labels)) {
            return new WP_Error(
                'missing_labels',
                'At least one label is required.',
                array('status' => 400)
            );
        }

        $repo = GitHub_Agent_Permission_Manager::normalize_repo_name($repo);

        // Labels use the Issues labels endpoint.
        $response = GitHub_API_Client::post_raw(
            sprintf('/repos/%s/issues/%d/labels', $repo, (int) $pr_number),
            array('labels' => array_map('sanitize_text_field', $labels))
        );

        if (is_wp_error($response)) {
            return $response;
        }

        do_action('github_agent_pr_labels_added', $user_id, $repo, $pr_number, $labels);

        return $response;
    }
}
