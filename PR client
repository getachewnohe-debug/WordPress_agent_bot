public static function get_raw($endpoint) {
    return self::get($endpoint);
}

public static function post_raw($endpoint, $payload) {
    return self::post($endpoint, $payload);
}

public static function patch_raw($endpoint, $payload) {
    return self::patch($endpoint, $payload);
}

public static function put_raw($endpoint, $payload) {
    $url = self::API_BASE . $endpoint;

    $response = wp_remote_request($url, array(
        'method'  => 'PUT',
        'timeout' => self::TIMEOUT,
        'headers' => self::headers(),
        'body'    => wp_json_encode($payload),
    ));

    return self::parse_response($response);
}
