final class GitHub_PR_Client {

    /**
     * Create a pull request.
     *
     * @param int    $user_id
     * @param string $repo      owner/repo
     * @param array  $pr {
     *     @type string   $title         Required.
     *     @type string   $head          Required. Branch to merge from.
     *     @type string   $base          Required. Branch to merge into.
     *     @type string   $body          Optional.
     *     @type bool     $draft         Optional. Default false.
     *     @type bool     $maintainer_can_modify  Optional. Default true.
     * }
     * @return array|WP_Error
     */
    public static function create_pr($user_id, $repo, array $pr) {
        try {
            GitHub_Agent_Permission_Manager::assert_can(
                $user_id,
                $repo,
                'create_pr',
                $pr['head'] ?? null
            );
        } catch (Exception $e) {
            return new WP_Error('permission_denied', $e->getMessage(), array('status' => 403));
        }

        $repo = GitHub_Agent_Permission_Manager::normalize_repo_name($repo);

        // Validate required fields.
        foreach (array('title', 'head', 'base') as $field) {
            if (empty(trim((string) ($pr[$field] ?? '')))) {
                return new WP_Error(
                    'missing_field',
                    sprintf('PR field "%s" is required.', $field),
                    array('status' => 400)
                );
            }
        }

        // Head and base must differ.
        if (trim($pr['head']) === trim($pr['base'])) {
            return new WP_Error(
                'invalid_branches',
                'Head and base branches must be different.',
                array('status' => 400)
            );
        }

        $payload = array(
            'title'                  => sanitize_text_field($pr['title']),
            'head'                   => sanitize_text_field($pr['head']),
            'base'                   => sanitize_text_field($pr['base']),
            'draft'                  => !empty($pr['draft']),
            'maintainer_can_modify'  => isset($pr['maintainer_can_modify'])
                                            ? (bool) $pr['maintainer_can_modify']
                                            : true,
        );

        if (!empty($pr['body'])) {
            $payload['body'] = wp_kses_post($pr['body']);
        }

        $response = GitHub_API_Client::post_raw(
            sprintf('/repos/%s/pulls', $repo),
            $payload
        );

        if (is_wp_error($response)) {
            return $response;
        }

        do_action('github_agent_pr_created', $user_id, $repo, $response);

        return $response;
    }

    /**
     * Get a single pull request.
     */
    public static function get_pr($user_id, $repo, $pr_number) {
        try {
            GitHub_Agent_Permission_Manager::assert_can($user_id, $repo, 'read');
        } catch (Exception $e) {
            return new WP_Error('permission_denied', $e->getMessage(), array('status' => 403));
        }

        $repo = GitHub_Agent_Permission_Manager::normalize_repo_name($repo);

        return GitHub_API_Client::get_raw(
            sprintf('/repos/%s/pulls/%d', $repo, (int) $pr_number)
        );
    }

    /**
     * List open pull requests.
     */
    public static function list_prs($user_id, $repo, $args = array()) {
        try {
            GitHub_Agent_Permission_Manager::assert_can($user_id, $repo, 'read');
        } catch (Exception $e) {
            return new WP_Error('permission_denied', $e->getMessage(), array('status' => 403));
        }

        $repo = GitHub_Agent_Permission_Manager::normalize_repo_name($repo);

        $valid_states = array('open', 'closed', 'all');
        $state = in_array($args['state'] ?? 'open', $valid_states, true)
            ? $args['state']
            : 'open';

        $per_page = min(100, max(1, (int) ($args['per_page'] ?? 30)));
        $page     = max(1, (int) ($args['page'] ?? 1));

        $query = http_build_query(array(
            'state'    => $state,
            'per_page' => $per_page,
            'page'     => $page,
        ));

        return GitHub_API_Client::get_raw(
            sprintf('/repos/%s/pulls?%s', $repo, $query)
        );
    }

    /**
     * Merge a pull request.
     *
     * @param array $options {
     *     @type string $commit_title    Optional.
     *     @type string $commit_message  Optional.
     *     @type string $merge_method    merge|squash|rebase. Default merge.
     *     @type string $sha             Required — must match PR head SHA.
     * }
     */
    public static function merge_pr(
        $user_id,
        $repo,
        $pr_number,
        array $options = array(),
        array $context = array()
    ) {
        // Fetch the PR first to get the base branch.
        $pr = self::get_pr($user_id, $repo, $pr_number);
        if (is_wp_error($pr)) {
            return $pr;
        }

        $base_branch = $pr['base']['ref'] ?? null;

        try {
            GitHub_Agent_Permission_Manager::assert_can(
                $user_id,
                $repo,
                'merge',
                $base_branch,
                null,
                $context
            );
        } catch (Exception $e) {
            return new WP_Error('permission_denied', $e->getMessage(), array('status' => 403));
        }

        // PR must be open.
        if (($pr['state'] ?? '') !== 'open') {
            return new WP_Error(
                'pr_not_open',
                sprintf('PR #%d is not open.', (int) $pr_number),
                array('status' => 409)
            );
        }

        // PR must not already be merged.
        if (!empty($pr['merged'])) {
            return new WP_Error(
                'pr_already_merged',
                sprintf('PR #%d is already merged.', (int) $pr_number),
                array('status' => 409)
            );
        }

        $repo = GitHub_Agent_Permission_Manager::normalize_repo_name($repo);

        $valid_methods = array('merge', 'squash', 'rebase');
        $merge_method  = in_array($options['merge_method'] ?? 'merge', $valid_methods, true)
            ? $options['merge_method']
            : 'merge';

        $payload = array(
            'merge_method' => $merge_method,
        );

        // SHA must match to prevent race conditions.
        if (!empty($options['sha'])) {
            $payload['sha'] = sanitize_text_field($options['sha']);
        }

        if (!empty($options['commit_title'])) {
            $payload['commit_title'] = sanitize_text_field($options['commit_title']);
        }

