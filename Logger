            $params[] = $args['actor'];
        }

        if (!empty($args['after'])) {
            $where[]  = 'created_at >= %s';
            $params[] = $args['after'];
        }

        if (!empty($args['before'])) {
            $where[]  = 'created_at <= %s';
            $params[] = $args['before'];
        }

        $where_sql = implode(' AND ', $where);
        $per_page  = max(1, min(200, (int) $args['per_page']));
        $offset    = ($args['page'] - 1) * $per_page;

